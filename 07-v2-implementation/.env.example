# Optional: enables real LLM explanations. Without this, StrideAI uses a deterministic fallback.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Optional cost observability. Populate these with your provider's current USD price per million tokens.
OPENAI_INPUT_COST_PER_MTOK=
OPENAI_OUTPUT_COST_PER_MTOK=
